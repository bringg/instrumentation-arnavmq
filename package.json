{
  "name": "instrumentation-arnavmq",
  "version": "2.0.1",
  "description": "OpenTelemetry automatic instrumentation for the `arnavmq` package",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p example/tsconfig.json --noEmit",
    "lint": "eslint . && prettier -c .",
    "format": "eslint . --fix && prettier --write .",
    "test": "dot-only-hunter test && nyc ts-mocha",
    "test:docker:run": "docker run -d --rm --name arnavmq-tests -p 5672:5672 rabbitmq:3.13-alpine"
  },
  "author": "Bring",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "./dist/src"
  ],
  "dependencies": {
    "@opentelemetry/instrumentation": "^0.221.0",
    "pkginfo": "^0.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@types/amqplib": "^0.10.8",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/pkginfo": "^0.4.4",
    "arnavmq": "^0.17.2",
    "chai": "^6.2.2",
    "dot-only-hunter": "^1.0.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "prettier": "^3.8.4",
    "ts-mocha": "^11.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120
  }
}
